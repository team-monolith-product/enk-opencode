# packages/opencode 에서 쓰는 환경변수 목록.
# 전체 플래그 정의는 src/flag/flag.ts 가 단일 소스다. 여기엔 개발할 때 자주 쓰는 것만 모았다.
# 실제 값은 .env 에 넣는다 (.env 는 gitignore 됨).

# ─────────────────────────────────────────────────────────────
# Provider API 키 (로컬 개발용. 프로덕션은 CHP 프록시 경유라 키를 직접 주입하지 않는다)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=

# ─────────────────────────────────────────────────────────────
# 모델 선택 (helm 이 주입하는 런타임 값. 로컬에선 원하는 모델로 덮어쓴다)
# ─────────────────────────────────────────────────────────────
# 기본 모델 "provider/model". config 에 model 이 없을 때 사용된다 (src/config/config.ts).
ENK_AI_MODEL=
# 위 모델의 variant (예: high). 비우면 기본.
ENK_AI_MODEL_VARIANT=
# 이미지가 포함된 메시지를 라우팅할 비전 모델 "provider/model".
# (docker/image-model-router-plugin.js) 비전 모델은 ENK_AI_MODEL 로 폴백하지 않는다.
ENK_AI_IMAGE_MODEL=
ENK_AI_IMAGE_MODEL_VARIANT=

# 모델 폴백 풀. "provider/model" 문자열 또는 { model, variant } 객체의 JSON 배열.
# "[]" 면 폴백 비활성. 자세한 동작은 src/enk/model-fallback.ts
ENK_AI_FALLBACK_MODELS=
# 다음 모델로 넘어가기 전 모델당 허용 재시도 횟수 (기본 3 → 모델당 1+3 스트림 시도)
ENK_AI_FALLBACK_RETRIES=
# 세션이 이 횟수만큼 폴백하면 이후 primary 모델에는 재시도를 주지 않는다 (기본 3)
ENK_AI_FALLBACK_STICKY_AFTER=

# models.dev 카탈로그 대체 (오프라인/사설 카탈로그용)
OPENCODE_MODELS_URL=
OPENCODE_MODELS_PATH=

# ─────────────────────────────────────────────────────────────
# 서버 / 인증
# ─────────────────────────────────────────────────────────────
# Basic auth 비밀번호. 비우면 `opencode serve`/`web` 이 무인증으로 뜬다(경고 출력).
OPENCODE_SERVER_PASSWORD=
# Basic auth 사용자명 (기본 "opencode")
OPENCODE_SERVER_USERNAME=
# serve 프록시(서브도메인 라우팅) 외부 주소. CSP 와 dev-server 안내 URL 에 쓰인다.
# 로컬에선 vite 서버 주소를 넣는다.
OPENCODE_SERVE_DOMAIN=http://localhost:3000
# 배포 환경 구분. helm 이 주입: "development" | "production"
ENVIRONMENT=
# 내장 web UI 비활성화 (app 을 따로 띄워 개발할 때)
OPENCODE_DISABLE_EMBEDDED_WEB_UI=

# ─────────────────────────────────────────────────────────────
# 저장소 / DB
# ─────────────────────────────────────────────────────────────
# DB 경로. ":memory:" 또는 절대경로면 그대로, 상대경로면 Global.Path.data 기준.
OPENCODE_DB=
# 네트워크 FS(EFS 등)에 DB 를 둘 때. locking_mode=EXCLUSIVE 로 WAL 의 -shm 의존 제거.
OPENCODE_DB_EXCLUSIVE_LOCK=
OPENCODE_SKIP_MIGRATIONS=

# ─────────────────────────────────────────────────────────────
# 설정 로딩
# ─────────────────────────────────────────────────────────────
# config 파일 경로 / 인라인 JSON / config 디렉터리
OPENCODE_CONFIG=
OPENCODE_CONFIG_CONTENT=
OPENCODE_CONFIG_DIR=
# 프로젝트 로컬 config(opencode.json) 무시
OPENCODE_DISABLE_PROJECT_CONFIG=

# ─────────────────────────────────────────────────────────────
# 개발 편의 토글 (truthy = "true" | "1")
# ─────────────────────────────────────────────────────────────
# edit/write 전 파일 mtime 검사 끄기. 외부 도구가 파일을 건드리는 개발 중에 유용.
OPENCODE_DISABLE_FILETIME_CHECK=1
OPENCODE_DISABLE_AUTOUPDATE=
OPENCODE_DISABLE_AUTOCOMPACT=
OPENCODE_DISABLE_LSP_DOWNLOAD=
OPENCODE_DISABLE_DEFAULT_PLUGINS=
OPENCODE_DISABLE_MODELS_FETCH=
OPENCODE_DISABLE_SHARE=
OPENCODE_SENTRY_DISABLED=
# 권한 정책 JSON 오버라이드
OPENCODE_PERMISSION=

# ─────────────────────────────────────────────────────────────
# Experimental (개별 플래그는 OPENCODE_EXPERIMENTAL=1 로 한 번에 켤 수 있다)
# ─────────────────────────────────────────────────────────────
OPENCODE_EXPERIMENTAL=
OPENCODE_EXPERIMENTAL_PLAN_MODE=
OPENCODE_EXPERIMENTAL_WORKSPACES=
OPENCODE_EXPERIMENTAL_FILEWATCHER=
OPENCODE_EXPERIMENTAL_DISABLE_FILEWATCHER=
# 워처 초기 재귀 크롤을 부팅 창 밖으로 미루는 지연(ms, 기본 5000). 테스트는 0.
OPENCODE_FILEWATCHER_DEFER_MS=
OPENCODE_ENABLE_QUESTION_TOOL=
OPENCODE_ENABLE_EXA=

# ─────────────────────────────────────────────────────────────
# 배포 환경에서 주입되는 값 (로컬에선 보통 비워둔다)
# ─────────────────────────────────────────────────────────────
# JupyterHub 연동 (hub 가 pod 에 자동 주입)
JUPYTERHUB_API_URL=
JUPYTERHUB_API_TOKEN=
JUPYTERHUB_USER=
JUPYTERHUB_CLIENT_ID=
JUPYTERHUB_OAUTH_CALLBACK_URL=
JUPYTERHUB_BASE_URL=
JUPYTERHUB_SERVICE_PREFIX=
# enk-hackathon-rails AI 사용량 리포팅 (ai_usages API).
# 둘 다 설정돼야 활성화된다. URL 은 호스트까지만 (src/enk/ai-usage.ts)
ENK_HACKATHON_RAILS_URL=
ENK_AI_USAGE_TOKEN=
# 스포너가 주입하는 프로젝트 디렉터리 (dev-server replay 기록 위치)
ENK_PROJECT_DIRECTORY=
