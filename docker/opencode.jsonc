{
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      // 브라우저 도구(agent-browser CLI) 중 학생 앱 디버깅과 무관하고, 도구 자체를 바꾸거나(설치·업그레이드·
      // 플러그인) 외부로 나가는(chat·dashboard·stream·connect) 하위 명령은 막는다. bash 를 자유롭게 쓰는
      // Build 에게는 우회로가 있으므로 보안 경계가 아니라 실수 방지용이다. "*" 보다 뒤에 있어야 이긴다.
      "agent-browser install*": "deny",
      "agent-browser upgrade*": "deny",
      "agent-browser chat*": "deny",
      "agent-browser connect*": "deny",
      "agent-browser plugin*": "deny",
      "agent-browser dashboard*": "deny",
      "agent-browser stream*": "deny",
      // 전역 옵션을 하위 명령 앞에 붙인 형태(`agent-browser --json install`)도 같이 막는다.
      "agent-browser -* install*": "deny",
      "agent-browser -* upgrade*": "deny",
      "agent-browser -* chat*": "deny",
      "agent-browser -* connect*": "deny",
      "agent-browser -* plugin*": "deny",
      "agent-browser -* dashboard*": "deny",
      "agent-browser -* stream*": "deny",
    },
  },
  "plugin": [
    "./preview-bridge-plugin.js",
    // 이미지/PDF 첨부 메시지를 비전 미지원 모델(deepseek 등) 대신 지정 모델로 라우팅.
    ["./image-model-router-plugin.js", { "model": "minimax/MiniMax-M3", "variant": "adaptive" }],
  ],
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "${ANTHROPIC_BASE_URL}",
        "apiKey": "proxy-auth",
      },
    },
    "google": {
      "options": {
        "baseURL": "${GEMINI_BASE_URL}",
        "apiKey": "proxy-auth",
      },
    },
    "openai": {
      "options": {
        "baseURL": "${OPENAI_BASE_URL}",
        "apiKey": "proxy-auth",
      },
    },
    "deepseek": {
      // CHP가 anthropic 규약을 제공함으로, 여기에도 anthropic 규약을 사용한다.
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "${DEEPSEEK_BASE_URL}",
        "apiKey": "proxy-auth",
      },
      "models": {
        // 아직 deepseek-v4-pro 모델이 제공되지 않음. 추후 제공되면 아래 주석을 해제하고 사용 가능.
        "deepseek-v4-pro": {},
      },
    },
    "minimax": {
      // CHP가 anthropic 규약을 제공함으로, 여기에도 anthropic 규약을 사용한다.
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "${MINIMAX_BASE_URL}",
        "apiKey": "proxy-auth",
      },
      "models": {
        "MiniMax-M3": {
          // 비전 라우팅의 목적지다. toModelMessages 가 이 값으로 이미지 전달 여부를 정하는데,
          // models.dev 를 못 받아오면 false 로 떨어져 비전이 조용히 죽는다. 명시적으로 못 박는다.
          "attachment": true,
          "variants": {
            "adaptive": {
              "thinking": { "type": "adaptive" },
            },
          },
        },
      },
    },
  },
  "agent": {
    // 최상위 "permission" 의 "*": "allow" 가 내장 plan 의 편집 금지를 덮는다(last-match-wins). 최초 기획을 받은 Plan 이
    // Build 전에 제품을 바꾸지 못하도록 다시 막는다.
    "plan": {
      "permission": {
        "edit": {
          "*": "deny",
          ".opencode/plans/*.md": "allow",
        },
        // 브라우저 도구(agent-browser, browser-check)도 bash 로만 돌므로 여기서 함께 막힌다.
        "bash": "deny",
        // explore 도 최상위 "allow" 를 물려받아 편집할 수 있으므로 서브에이전트를 아예 막는다.
        "task": "deny",
        "generate_image": "deny",
        "ensure_dev_server": "deny",
        "env_request": "deny",
      },
    },
  },
  "ensureSession": true,
  "ensureOneSession": true,
}
